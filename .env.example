# ==============================================================================
# TestDino Backend — Environment Configuration (.env.example)
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# Node environment: development | test | production
NODE_ENV=development
PORT=3000

# Comma-separated allowed origins for CORS, or * for any.
# In production, set this to your frontend's URL (e.g. https://app.yourdomain.com).
CORS_ORIGIN=*

# MongoDB connection string (Required for server bootstrap)
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# Secret used to sign and verify JWT tokens (>= 32 chars in production)
JWT_SECRET=your-jwt-secret-at-least-32-chars

# LLM Configuration (openai | openrouter | anthropic | mock)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONCURRENCY=2
LLM_MIN_INTERVAL_MS=0

# Crawler / Fetch Configuration
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2000000
CRAWL_MAX_PAGES=10
CRAWL_DELAY_MS=500
ALLOW_PRIVATE_HOSTS=false
